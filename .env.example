# Copy to .env and explicitly source it; the server does not load files implicitly.
DATABASE_URL=postgres://vediomind:vediomind_dev@127.0.0.1:55437/vediomind?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:5173
APP_ENV=development
# Optional until analysis is needed. Configure both; never expose these in VITE_*.
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=
# Conservative byte-based prompt estimate + output reserve + 2048 safety allowance.
# Set this below the chosen model's actual context limit.
AI_CONTEXT_BUDGET=48000
AI_OUTPUT_TOKENS=4096
WORKER_CONCURRENCY=2
YTDLP_BINARY=yt-dlp
YTDLP_PROXY=
# Comma-separated addresses/CIDRs of actual reverse proxies; empty trusts none.
TRUSTED_PROXIES=
